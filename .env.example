OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_1_MAX_OUTPUT_TOKENS=16384
AGENT_1_MAX_ROUNDS=10
AGENT_1_STREAM=true
AGENT_1_REASONING_ENABLED=true
# Optional input + output token stop threshold for one task; blank disables it.
# Checked after each response, so a request's input can exceed the remaining budget.
AGENT_1_MAX_TASK_TOKENS=
# Relative to the launch directory. Use ~/.agent-1 for a home directory store.
AGENT_1_DATA_DIR=.agent-1
